{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "app-shell",
  "description": "Permissions for the settings window: listening for settings changes, closing itself, the folder picker and app-shell commands. Global shortcuts and autostart stay in Rust.",
  "windows": ["settings"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "dialog:allow-open",
    "allow-settings-get",
    "allow-settings-update",
    "allow-settings-check-save-dir",
    "allow-hotkeys-status",
    "allow-hotkeys-retry",
    "allow-hotkeys-suspend",
    "allow-hotkeys-resume"
  ]
}
