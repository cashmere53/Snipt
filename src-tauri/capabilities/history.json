{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "history",
  "description": "Permissions for the history window: core defaults and the capture-library commands. Ids only; paths never come from the webview.",
  "windows": ["history"],
  "permissions": [
    "core:default",
    "allow-library-list",
    "allow-library-open-in-editor",
    "allow-library-copy",
    "allow-library-reveal",
    "allow-library-delete",
    "allow-library-prune-missing"
  ]
}
